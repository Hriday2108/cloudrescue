# ==============================================================
# CloudRescue Backend Environment Configuration Template
# COPY this file to .env and fill in your actual AWS & server settings.
# NEVER commit your real .env file or real credentials to Git!
# ==============================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend CORS Origin (comma-separated if multiple)
FRONTEND_ORIGIN=http://localhost:5173

# AWS Region & S3 Configuration
# S3_BUCKET_NAME must point to a private S3 bucket created in your AWS account
AWS_REGION=us-east-1
S3_BUCKET_NAME=my-cloudrescue-private-backups

# AWS SNS Configuration (Optional)
# Leave blank to run with notifications disabled
SNS_TOPIC_ARN=arn:aws:sns:us-east-1:123456789012:cloudrescue-alerts

# Upload Controls
# Max file size in bytes (default: 52428800 = 50 MB)
MAX_FILE_SIZE_BYTES=52428800
# Allowed file extensions (comma-separated, without dot)
ALLOWED_FILE_EXTENSIONS=sql,tar,gz,zip,json,csv,log,bak,dump,txt

# Safe Recovery Staging Path (Optional server folder to stage restores if requested)
RESTORE_STAGE_PATH=./restore_stage
